{
  "extends": ["config:recommended"],
  "commitMessagePrefix": "chore(deps):",
  "labels": ["dependencies"],
  "dependencyDashboard": false,
  "enabledManagers": ["cargo", "github-actions", "npm"],
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "schedule": ["before 4am on Monday"],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["clap", "clap_*"],
      "groupName": "clap"
    },
    {
      "matchManagers": ["cargo"],
      "matchPackageNames": ["gix", "gix-*"],
      "groupName": "gix"
    },
    {
      "description": "image 0.25 implements ColorMap only for color_quant 1.x NeuQuant; lift once image moves to color_quant 2",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["color_quant"],
      "allowedVersions": "<2"
    },
    {
      "matchManagers": ["github-actions"],
      "schedule": ["before 4am on Monday"]
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["site/**"],
      "schedule": ["before 4am on the first day of the month"],
      "groupName": "site",
      "rangeStrategy": "bump"
    },
    {
      "description": "SvelteKit's peer range is typescript ^6 and TS 7 lacks the JS compiler API it needs (sveltejs/kit#17539); lift once SvelteKit supports TS 7",
      "matchManagers": ["npm"],
      "matchFileNames": ["site/**"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}

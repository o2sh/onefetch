{
  "name": "onefetch-web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "vite",
    "prebuild": "svelte-kit sync",
    "build": "vite build",
    "format": "prettier -w .",
    "preview": "vite preview",
    "check": "npm run check:svelte && npm run check:prettier && npm run check:lint",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:prettier": "prettier --check **/*.{ts,js,svelte,css,html,json}",
    "check:lint": "eslint"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "5.0.1",
    "@sveltejs/adapter-auto": "8.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/eslint": "9.6.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  },
  "dependencies": {
    "svelte-hot-french-toast": "4.1.2"
  }
}
